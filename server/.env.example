# Postgres connection string (Render/Railway/Supabase all give you one of these)
DATABASE_URL="postgresql://user:password@host:5432/captiongenerator"

# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# Comma-separated list of origins allowed to call this API from a browser,
# e.g. the URL of your published Claude artifact and/or GitHub Pages site.
# Leave blank in local dev to allow any origin.
CORS_ORIGIN=""

# Leave unset (or "false") in any real deployment. Sets this to "true"
# only in your own local/dev environment to test the free-tier limit
# and upgrade flow before a real payment gateway is wired in — see
# server/README.md for why this must never be true in production.
ALLOW_DEV_BILLING_STUB="false"
