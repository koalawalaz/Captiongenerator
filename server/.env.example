# Generate your own keypair once with: node generate-keys.js
# Paste the PRIVATE half here. Never commit the real value.
LICENSE_PRIVATE_KEY_B64=""

PORT=4000

# Comma-separated list of origins allowed to call this from a browser,
# e.g. your GitHub Pages URL. Leave blank in local dev to allow any origin.
CORS_ORIGIN=""

# Your Gumroad product's permalink (the short code in its URL, e.g.
# gumroad.com/l/abcde -> "abcde"). The webhook refuses to mint a license
# for any sale that doesn't match this.
GUMROAD_PRODUCT_PERMALINK=""

# Optional: only set this in tests, to point the Gumroad license-verify
# call at a local mock server instead of the real https://api.gumroad.com.
GUMROAD_VERIFY_URL=""

# Optional: Resend (https://resend.com) API key, to email the license key
# to the buyer automatically. If unset, the webhook logs the minted key
# to the server console instead so you can hand-deliver it while testing.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
